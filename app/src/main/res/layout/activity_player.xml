<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:background="@drawable/badge_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="@string/live"
        android:textColor="@color/text"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- "What's on" bar, shown for a few seconds when the programme starts or a key is pressed. -->
    <LinearLayout
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/info_bg"
        android:orientation="vertical"
        android:paddingHorizontal="48dp"
        android:paddingTop="64dp"
        android:paddingBottom="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/info_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/info_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dim"
            android:textSize="17sp" />

        <ProgressBar
            android:id="@+id/info_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginVertical="10dp"
            android:max="1000"
            android:progressTint="@color/accent" />

        <TextView
            android:id="@+id/info_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dim"
            android:textSize="16sp" />

        <Button
            android:id="@+id/info_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/row_bg"
            android:paddingHorizontal="20dp"
            android:text="@string/tv_guide"
            android:textAllCaps="false"
            android:textColor="@color/text" />
    </LinearLayout>

    <!-- Off air: a clock, what is next, and today's guide. -->
    <LinearLayout
        android:id="@+id/off_air"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/off_air_bg"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="40dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/text"
                android:textSize="64sp" />

            <TextView
                android:id="@+id/off_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/off_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/accent"
                android:textSize="36sp" />

            <TextView
                android:id="@+id/error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/live"
                android:textSize="15sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/guide_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/row_bg"
                android:paddingHorizontal="20dp"
                android:text="@string/tv_guide_settings"
                android:textAllCaps="false"
                android:textColor="@color/text" />
        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:focusable="false">

            <TextView
                android:id="@+id/guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/text_dim"
                android:textSize="16sp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
