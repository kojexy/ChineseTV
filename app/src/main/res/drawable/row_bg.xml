<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#40E8B04B" /><stroke android:width="2dp" android:color="@color/row_focus" /><corners android:radius="8dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#40E8B04B" /><corners android:radius="8dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/row_idle" /><corners android:radius="8dp" /></shape>
    </item>
</selector>
